# Environment for the user-management service (loaded by systemd via EnvironmentFile).
# Plain KEY=VALUE lines, no quotes. Non-secret configuration only: the actual values
# (Cognito pool id, DynamoDB table, region) are read from SSM Parameter Store at startup.
# This file is overwritten on every deployment, so change values here (in git), not on the server.

# SSM path prefix that holds the parameters
SSM_PARAM_PREFIX=/event-management/auth/

# Names of the SSM parameters (relative to the prefix)
SSM_PARAM_USER_POOL_ID=user-pool-id
SSM_PARAM_REGION=AWS_REGION
SSM_PARAM_TABLE_NAME=DYNAMODB_TABLE_NAME

# HTTP port
PORT=8080

# Optional: region for the SSM client. On EC2 the SDK discovers it from instance metadata,
# so only set this if that does not work.
# AWS_REGION=ap-south-1
