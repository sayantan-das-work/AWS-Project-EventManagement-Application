<configuration>
  <!-- Never log request bodies or credentials. Log only ids and error codes.
       %X{correlationId} is set for every HTTP request by RequestContextHandler. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{ISO8601, UTC} %-5level [%thread] [cid=%X{correlationId:-none}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
